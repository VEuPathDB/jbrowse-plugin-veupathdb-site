{
  "version": "0.0.1",
  "name": "jbrowse-plugin-veupathdb-site",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "veupathdb"
  ],
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "config": {
    "port": 9005,
    "jbrowse": {
      "plugin": {
        "name": "VEuPathDBSite"
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "start": "npm-run-all --sequential clean --parallel start:*",
    "start:watch": "cross-env JB_NPM=false NODE_ENV=development rollup --config --watch",
    "start:server": "serve --cors --listen $npm_package_config_port .",
    "serve": "serve --cors --listen $npm_package_config_port .",
    "prebuild": "rimraf dist",
    "build": "cross-env JB_NPM=false rollup --config",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .js,.ts,.jsx,.tsx src/",
    "prepack": "npm-run-all build"
  },
  "jbrowse-plugin": {
    "name": "VEuPathDBSite"
  },
  "peerDependencies": {
    "@jbrowse/core": "^5.0.0-beta.18",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.16.5",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.10.4",
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.14.1",
    "@jbrowse/core": "5.0.0-beta.18",
    "@jbrowse/development-tools": "^2.2.1",
    "@jbrowse/mobx-state-tree": "^6.10.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@types/jest": "^29.5.11",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-react": "^7.20.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.6.1",
    "mobx": "^7.1.1",
    "mobx-react": "^10.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^5.0.1",
    "rollup": "^3.0.0",
    "rxjs": "^7.8.2",
    "serve": "^14.2.0",
    "ts-jest": "^29.1.1",
    "tslib": "^2.8.1",
    "tss-react": "^4.8.6",
    "typescript": "^5.9.3"
  },
  "private": true
}
